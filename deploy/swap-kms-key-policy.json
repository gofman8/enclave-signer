{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAttestedSeedOperations",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_SIGNER_ROLE"
      },
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "kms:RecipientAttestation:PCR0": "REPLACE_APPROVED_PCR0"
        },
        "StringEquals": {
          "kms:EncryptionContext:application": "utexo-enclave-signer",
          "kms:EncryptionContext:flow": "rgb-swap",
          "kms:EncryptionContext:seed_id": "REPLACE_SEED_ID",
          "kms:EncryptionContext:bitcoin_network": "REPLACE_BITCOIN_NETWORK"
        },
        "ForAllValues:StringEquals": {
          "kms:EncryptionContextKeys": [
            "application",
            "flow",
            "seed_id",
            "bitcoin_network"
          ]
        }
      }
    },
    {
      "Sid": "DenyUnapprovedImages",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_SIGNER_ROLE"
      },
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEqualsIgnoreCase": {
          "kms:RecipientAttestation:PCR0": "REPLACE_APPROVED_PCR0"
        }
      }
    },
    {
      "Sid": "DenySignerRequestsWithoutRecipientAttestation",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_SIGNER_ROLE"
      },
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "kms:RecipientAttestation:PCR0": "true"
        }
      }
    },
    {
      "Sid": "DenyWrongOrMissingApplication",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_SIGNER_ROLE"
      },
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "kms:EncryptionContext:application": "utexo-enclave-signer"
        }
      }
    },
    {
      "Sid": "DenyWrongOrMissingFlow",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_SIGNER_ROLE"
      },
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "kms:EncryptionContext:flow": "rgb-swap"
        }
      }
    },
    {
      "Sid": "DenyWrongOrMissingSeedIdentity",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_SIGNER_ROLE"
      },
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "kms:EncryptionContext:seed_id": "REPLACE_SEED_ID"
        }
      }
    },
    {
      "Sid": "DenyWrongOrMissingBitcoinNetwork",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_SIGNER_ROLE"
      },
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "kms:EncryptionContext:bitcoin_network": "REPLACE_BITCOIN_NETWORK"
        }
      }
    },
    {
      "Sid": "DenyUnexpectedEncryptionContextKeys",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_SIGNER_ROLE"
      },
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringNotEquals": {
          "kms:EncryptionContextKeys": [
            "application",
            "flow",
            "seed_id",
            "bitcoin_network"
          ]
        }
      }
    },
    {
      "Sid": "DenySignerAlternateSeedCreationAndPolicyChanges",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_SIGNER_ROLE"
      },
      "Action": [
        "kms:Encrypt",
        "kms:ReEncrypt*",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:GenerateDataKeyPair*",
        "kms:CreateGrant",
        "kms:PutKeyPolicy",
        "kms:ReplicateKey",
        "kms:UpdatePrimaryRegion",
        "kms:ImportKeyMaterial",
        "kms:DeleteImportedKeyMaterial",
        "kms:DisableKey",
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "*"
    }
  ]
}
